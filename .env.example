# Copy to .env and fill in. Never commit real values.
# In production these live only in Vercel / Fly env settings.

# Database (local Postgres or a Neon dev branch)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/a11y_fixer

# LLM
ANTHROPIC_API_KEY=
LLM_MONTHLY_BUDGET_USD=20
# record | replay | live
LLM_MODE=replay

# Auth.js (GitHub provider)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed to use the app
ALLOWED_GITHUB_LOGINS=CaseyKelly,upasanaajbani

# GitHub App (worker only)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
