# Copy to .env and fill in. Never commit .env.

# Postgres. Local Docker (`docker compose up -d`):
#   postgres://postgres:postgres@localhost:5432/curbcut
# Or a Neon dev branch: use its direct connection string (host without -pooler),
# with ?sslmode=require.
DATABASE_URL=

# Worker. Local development only: lets the scanner reach localhost (e.g. the
# sample site). Refused when NODE_ENV=production.
ALLOW_PRIVATE_SCAN_TARGETS=false

# Claude
ANTHROPIC_API_KEY=
LLM_MONTHLY_BUDGET_USD=20
# live, record, or replay. Defaults to replay outside production, so local
# work costs nothing until you opt in.
LLM_MODE=
# Where record mode saves responses and replay mode reads them.
LLM_RECORDINGS_DIR=

# GitHub sign-in (Auth.js)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGINS=CaseyKelly,UpasanaAjbani
