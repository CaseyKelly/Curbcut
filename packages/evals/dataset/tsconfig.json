{
  // Type-checks every case's input and reference fix, so the bugs are
  // accessibility bugs, not build errors. Scorer (b) needs inputs that compile.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx"
  },
  "include": ["cases/*/input/**/*.tsx", "cases/*/expected/**/*.tsx"]
}
